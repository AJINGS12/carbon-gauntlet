# Copy to apps/api/.env (backend) and contracts/.env (deployment).
# Never commit real values. In production these live in Render's environment settings.

# --- Backend (apps/api) ---
PORT=4000
ANTHROPIC_API_KEY=                     # LLM for verifier + agents. Empty = rule checks only
LLM_MODEL=claude-haiku-5-5             # default for agents and verifier (cheaper)
AGENT_MODEL=                           # optional override for the attacker agents, e.g. claude-sonnet-5-5 for the recorded demo
VERIFIER_MODEL=                        # optional override for the verifier
LLM_TIMEOUT_MS=20000                   # per model call; on timeout the verifier falls back to rules
LIVE_RUN_CODE=                         # optional: access code for live runs on a demo-mode site (6+ chars)
LIVE_RUNS_PER_DAY=10                   # cap on live runs per day (each one calls the model)
SUPABASE_URL=                          # saved live runs (docs/records.sql). Empty = kept in memory until restart
SUPABASE_SECRET_KEY=                   # sb_secret_... server only
ANCHOR_RUNS=false                      # true = anchor each saved run's fingerprint on the protected registry (needs OPERATOR_PRIVATE_KEY)
DEMO_MODE=true                         # true = replay recorded traces, never call the LLM (safe for judges)
RECORD_TRACES=false                    # true = save live agent decisions + verifier investigations to data/traces for demo replay
RUN_SEED=42

# Chain: "mock" (in-memory, default), "local" (Hardhat node) or "testnet" (Base Sepolia)
CHAIN_MODE=mock
PROVE_REVERTS=false                    # true = blocked attempts are still sent, so the explorer shows them as FAILED transactions
RPC_URL=https://sepolia.base.org
OPERATOR_PRIVATE_KEY=                  # backend wallet (operator + verifier roles), testnet only
REGISTRY_PROTECTED_ADDRESS=
REGISTRY_UNPROTECTED_ADDRESS=

CORS_ORIGIN=http://localhost:5173      # set to your Vercel URL in production

# --- Frontend (apps/web, set in Vercel) ---
VITE_API_URL=http://localhost:4000
VITE_EXPLORER_URL=https://sepolia.basescan.org
VITE_REPO_URL=https://github.com/AJINGS12/carbon-gauntlet
