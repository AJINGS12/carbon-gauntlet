# Copy to apps/api/.env (backend) and contracts/.env (deployment).
# Never commit real values. In production these live in Render's environment settings.

# --- Backend (apps/api) ---
PORT=4000
DATABASE_URL=postgresql://user:password@host/carbon_gauntlet?sslmode=require   # Neon connection string
ANTHROPIC_API_KEY=                     # LLM for verifier + agents. Empty = rule checks only
LLM_MODEL=claude-sonnet-5-5
LLM_TIMEOUT_MS=20000                   # per model call; on timeout the verifier falls back to rules
DEMO_MODE=true                         # true = replay recorded traces, never call the LLM (safe for judges)
RECORD_TRACES=false                    # true = save live agent decisions + verifier investigations to data/traces for demo replay
RUN_SEED=42

# Chain: "mock" for local dev, "testnet" for Base Sepolia
CHAIN_MODE=mock
RPC_URL=https://sepolia.base.org
OPERATOR_PRIVATE_KEY=                  # backend wallet (operator + verifier roles), testnet only
REGISTRY_PROTECTED_ADDRESS=
REGISTRY_UNPROTECTED_ADDRESS=

CORS_ORIGIN=http://localhost:5173      # set to your Vercel URL in production

# --- Frontend (apps/web, set in Vercel) ---
VITE_API_URL=http://localhost:4000
VITE_EXPLORER_URL=https://sepolia.basescan.org
